const { makeWASocket, DisconnectReason, prepareWAMessageMedia, Browsers, makeCacheableSignalKeyStore } = require('stian-baileys');
const { useMongoAuthState } = require('baileys-mongodb');
const P = require('pino');
const qrcode = require('qrcode-terminal');
const https = require('https');
const { getLinkPreview } = require('link-preview-js');
const express = require('express');

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const logger = P({ level: 'silent' });

// The connection string will be pulled from Render's Environment Variables
const MONGO_URI = process.env.MONGO_URI; 
const SESSION_ID = 'whatsapp-bot-session'; 

const fetchImageBuffer = (url) => {
    return new Promise((resolve, reject) => {
        const options = { headers: { 'User-Agent': 'Mozilla/5.0' } };
        https.get(url, options, (res) => {
            if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
                return fetchImageBuffer(res.headers.location).then(resolve).catch(reject);
            }
            if (res.statusCode !== 200) return reject(new Error("Status " + res.statusCode));
            const data = [];
            res.on('data', (chunk) => data.push(chunk));
            res.on('end', () => resolve(Buffer.concat(data)));
        }).on('error', reject);
    });
};

async function startBot() {
    try {
        const { state, saveCreds } = await useMongoAuthState(MONGO_URI, SESSION_ID);
        
        const sock = makeWASocket({ 
            version: [2, 3000, 1023223821], 
            auth: {
                creds: state.creds,
                keys: makeCacheableSignalKeyStore(state.keys, logger), 
            },
            printQRInTerminal: false, 
            logger: logger,
            browser: Browsers.macOS('Desktop'), 
            markOnlineOnConnect: false,
            syncFullHistory: false, 
            keepAliveIntervalMs: 60000 
        });

        sock.ev.on('creds.update', saveCreds);

        let qrShown = false;

        sock.ev.on('connection.update', async (update) => {
            const { connection, lastDisconnect, qr } = update;

            if (qr && !qrShown) {
                qrShown = true;
                console.log('\n📸 SCREENSHOT THIS QR CODE IMMEDIATELY:');
                qrcode.generate(qr, { small: true });
            }

            if (connection === 'close') {
                const statusCode = lastDisconnect?.error?.output?.statusCode;
                if (statusCode === DisconnectReason.loggedOut) {
                    console.log('\n❌ Logged out.');
                    process.exit(0); 
                } else if (statusCode === 515) {
                    qrShown = false;
                    startBot(); 
                } else {
                    console.log('\n📶 Connection lost. Retrying in 10s...');
                    setTimeout(startBot, 10000); 
                }
            } else if (connection === 'open') {
                console.log('\n✅ Bot connected successfully!');
                const myJid = `${sock.user.id.split(':')[0]}@s.whatsapp.net`;
                await sock.sendMessage(myJid, { text: "🛡️ Bot active on Render." });
                simulateHumanBehavior(sock); 
            }
        });

        sock.ev.on('messages.upsert', async (m) => {
            const msg = m.messages[0];
            if (!msg.message || !msg.key.fromMe) return;

            const text = msg.message.conversation || msg.message.extendedTextMessage?.text;
            
            if (text && text.startsWith('.grstatus ')) {
                const statusMessage = text.replace('.grstatus ', '').trim();
                const myJid = `${sock.user.id.split(':')[0]}@s.whatsapp.net`;

                console.log('\n🚀 Command detected! Preparing status...');
                await sock.sendMessage(myJid, { text: "⏳ Preparing status..." });

                try {
                    const groups = await sock.groupFetchAllParticipating();
                    let validGroups = Object.values(groups).filter(g => !g.announce); 
                    validGroups = validGroups.sort(() => Math.random() - 0.5);
                    
                    const urlRegex = /(https?:\/\/[^\s]+)/g;
                    const urls = statusMessage.match(urlRegex);
                    
                    let imgBuffer = null;
                    let channelName = "Join the Channel";
                    let channelDesc = "Click the link to view";

                    if (urls && urls.length > 0) {
                        const targetUrl = urls[0];
                        
                        if (targetUrl.includes('whatsapp.com/channel/')) {
                            const channelId = targetUrl.split('/channel/')[1]?.split('?')[0];
                            if (channelId) {
                                try {
                                    const metadata = await sock.newsletterMetadata("invite", channelId);
                                    if (metadata) {
                                        channelName = metadata.name || channelName;
                                        channelDesc = metadata.description || channelDesc;
                                        if (metadata.preview) imgBuffer = await fetchImageBuffer(metadata.preview);
                                    }
                                } catch (e) { }
                            }
                        } 
                        else if (targetUrl.includes('chat.whatsapp.com/')) {
                            const inviteCode = targetUrl.split('/').pop();
                            try {
                                const groupInfo = await sock.groupGetInviteInfo(inviteCode);
                                if (groupInfo) {
                                    channelName = groupInfo.subject || channelName;
                                    channelDesc = groupInfo.desc || channelDesc;
                                }
                            } catch (e) { }
                        } 
                        else {
                            try {
                                const preview = await getLinkPreview(targetUrl, { headers: { 'user-agent': 'Mozilla/5.0' } });
                                if (preview.title) channelName = preview.title;
                                if (preview.description) channelDesc = preview.description;
                                if (preview.images && preview.images.length > 0) {
                                    imgBuffer = await fetchImageBuffer(preview.images[0]);
                                }
                            } catch (e) { }
                        }
                    }

                    if (!imgBuffer) {
                        try {
                            imgBuffer = await fetchImageBuffer('https://picsum.photos/500/500.jpg');
                        } catch (e) { }
                    }

                    let content = { text: statusMessage };
                    if (imgBuffer) {
                        const { imageMessage } = await prepareWAMessageMedia(
                            { image: imgBuffer },
                            { upload: sock.waUploadToServer, mediaTypeOverride: 'thumbnail-link' }
                        );
                        imageMessage.height = 720;
                        imageMessage.width = 480;

                        content = {
                            text: statusMessage,
                            linkPreview: {
                                'matched-text': urls ? urls[0] : '',
                                'canonical-url': urls ? urls[0] : '',
                                title: channelName,
                                description: channelDesc,
                                previewType: 0, 
                                jpegThumbnail: imgBuffer,
                                highQualityThumbnail: imageMessage,
                                linkPreviewMetadata: { socialMediaPostType: 4, linkMediaDuration: 0 }
                            }
                        };
                    }

                    await sock.sendMessage(myJid, { text: "📊 Found " + validGroups.length + " groups. Posting NOW..." });

                    let count = 1;
                    let successCount = 0;
                    let batchCount = 0;

                    for (const group of validGroups) {
                        try {
                            await sock.stianStatus.sendGroupStatus(group.id, content);
                            successCount++;
                            batchCount++;
                            console.log("[" + count + "/" + validGroups.length + "] Posted to: " + group.subject);
                        } catch (err) {
                            console.log("❌ Failed: " + err.message);
                        }
                        
                        count++;
                        if (count <= validGroups.length) {
                            const humanJitter = Math.floor(Math.random() * 400) + 100;
                            await sleep(1000 + humanJitter); 

                            if (batchCount === 20) {
                                await sleep(10000);
                                batchCount = 0; 
                            }
                        }
                    }
                    
                    await sock.sendMessage(myJid, { text: "🎉 Finished! Successfully posted to " + successCount + "/" + validGroups.length + " groups." });
                } catch (error) {
                    console.log("❌ Error:", error);
                }
            }
        });
    } catch (err) {
        console.log("Failed to start:", err);
    }
}

async function simulateHumanBehavior(sock) {
    while (true) {
        const waitMins = Math.floor(Math.random() * (90 - 30 + 1)) + 30;
        await sleep(waitMins * 60 * 1000);
        try {
            const myJid = `${sock.user.id.split(':')[0]}@s.whatsapp.net`;
            await sock.sendPresenceUpdate('available');
            await sleep(Math.floor(Math.random() * 3000) + 2000);
            await sock.sendPresenceUpdate('composing', myJid);
            await sleep(Math.floor(Math.random() * 4000) + 3000);
            await sock.sendPresenceUpdate('paused', myJid);
            await sleep(5000);
            await sock.sendPresenceUpdate('unavailable');
        } catch (error) {}
    }
}

const app = express();
app.get('/', (req, res) => res.send('Bot is running!'));
app.listen(process.env.PORT || 3000, () => console.log('Server ready'));

setInterval(() => {
    if (process.env.RENDER_EXTERNAL_URL) {
        https.get(process.env.RENDER_EXTERNAL_URL, (res) => console.log(`Ping: ${res.statusCode}`)).on('error', (err) => console.log('Ping error'));
    }
}, 14 * 60 * 1000);

startBot();
